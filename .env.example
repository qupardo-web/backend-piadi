# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.

# Secreto para firmar JWT. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Origen(es) permitidos por CORS, separados por coma (sin barra final).
CORS_ORIGIN=http://localhost:5173
