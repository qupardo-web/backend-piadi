# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.

# Secreto para firmar JWT. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duración de la sesión JWT. Admite formatos de jsonwebtoken como 30m, 2h o 1d.
JWT_EXPIRATION=2h

# Tamaño máximo de archivos de carga, expresado en MB.
MAX_UPLOAD_SIZE_MB=10

# Pool de conexiones PostgreSQL.
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# URL pública mostrada por Swagger. En desarrollo puede conservar localhost.
SWAGGER_URL=http://localhost:5000

# Origen(es) permitidos por CORS, separados por coma (sin barra final).
CORS_ORIGIN=http://localhost:5173
